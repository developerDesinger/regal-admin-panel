# Development environment — loaded automatically by `npm run dev`.
#
# Requests are NOT sent to the API origin directly: `vite.config.ts` proxies
# /api → VITE_API_TUNNEL so the browser sees a same-origin request. That matters
# because the session cookie is Secure + SameSite=Strict, and a strict cookie is
# never sent on a cross-site request — calling the API origin directly would
# silently drop auth on every call, and CORS preflights would need handling too.
#
# Points at the deployed backend. Override with a local server or a dev tunnel
# in .env.local (gitignored) when you need to work against your own instance:
#   VITE_API_TUNNEL=http://localhost:5000
VITE_API_TUNNEL=https://regal-backend-ypkwe.ondigitalocean.app

# Origin only; the client appends /api/v1/admin. Empty = same-origin (proxied).
VITE_API_BASE_URL=

# Environment chip in the topbar (§3).
VITE_ENV=STAGING
