# Copy to `.env.local` and adjust. `.env.local` is gitignored.
#
# The panel always calls a SAME-ORIGIN /api path, and something proxies it to
# the backend: vite in dev and preview, the rewrite in vercel.json in
# production. That is deliberate — the session cookie is Secure +
# SameSite=Strict, so a cross-site call would never carry it.
#
# So VITE_API_BASE_URL stays EMPTY in every environment, including Vercel.
# Only set it if you deploy the API on the same site as the panel and want to
# skip the proxy.

# Backend origin the dev/preview server proxies /api to. Not used in production
# — vercel.json holds that target — and it never reaches the built bundle.
VITE_API_TUNNEL=https://regal-backend-ypkwe.ondigitalocean.app

# Origin only; the client appends /api/v1/admin. Empty = same-origin (proxied).
VITE_API_BASE_URL=

# Topbar environment chip: PROD | STAGING
VITE_ENV=STAGING
