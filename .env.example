# Copy to `.env.local` and adjust. `.env.local` is gitignored.
#
# In development, VITE_API_BASE_URL is a same-origin path and vite proxies it
# to VITE_API_TUNNEL (see vite.config.ts). In production on Vercel, set
# VITE_API_BASE_URL to the deployed API's absolute origin instead and leave
# VITE_API_TUNNEL unset — there is no proxy in a static build.

# Backend origin to proxy to during development.
VITE_API_TUNNEL=https://kcxpbgbd-5050.euw.devtunnels.ms

# Dev: same-origin path (proxied). Production: absolute URL, e.g.
#   https://api.regal.app/api/v1/admin
VITE_API_BASE_URL=/api/v1/admin

# Topbar environment chip: PROD | STAGING
VITE_ENV=STAGING

# mock | api
VITE_DATA_SOURCE=mock
