# Development environment — loaded automatically by `npm run dev`.
#
# The admin API runs behind a VS Code dev tunnel. Requests are NOT sent to it
# directly: `vite.config.ts` proxies /api → VITE_API_TUNNEL so the browser sees
# a same-origin request. That matters because the session cookie is specified as
# SameSite=Strict (§01), and a strict cookie is never sent on a cross-site
# request — talking to the tunnel origin directly would silently drop auth on
# every call, and CORS preflights would need handling on top.
#
# Point VITE_API_TUNNEL at whoever is hosting the backend right now.
VITE_API_TUNNEL=https://kcxpbgbd-5050.euw.devtunnels.ms

# Origin only; the client appends /api/v1/admin. Empty = same-origin (proxied).
VITE_API_BASE_URL=

# Environment chip in the topbar (§3).
VITE_ENV=STAGING

# Data source: `mock` renders the fixtures in lib/mock/data.ts, `api` calls the
# backend. Flip to `api` once the endpoints in docs/BACKEND_API_REQUIREMENTS.md
# exist; until then the panel stays on fixtures.
VITE_DATA_SOURCE=mock
